# ==============================================================================
# Garden City Underworld — Environment Configuration Template (.env.example)
# ==============================================================================
# CRITICAL SECURITY RULE:
# - NEVER commit a real `.env` or `.env.local` file to git.
# - NEVER put secrets, private keys, database passwords, or API tokens into any
#   variable prefixed with `VITE_` — Vite embeds `VITE_*` variables verbatim into
#   the public client JavaScript bundle!
# - The build gate (`scripts/check-client-secrets.mjs`) will FAIL the build if
#   any secret or sensitive token is detected in client source or `dist/`.
# ==============================================================================

# --- Public Client Configuration (non-secret only) ----------------------------
# Optional base URL for future authoritative online API (HTTPS only, empty = offline single-player)
VITE_API_ORIGIN=
# Optional WebSocket URL for future co-op server (WSS only, empty = offline single-player)
VITE_WS_ORIGIN=
# Optional privacy/security contact shown in-app
VITE_SECURITY_CONTACT=security@gardencityunderworld.example

# --- Server-Only Secrets (Phases 3-7 backend ONLY — NEVER prefix with VITE_) --
# Database connection string (least-privilege user, TLS required, private network only)
DATABASE_URL=
# Signing secret for rotating session tokens / CSRF (generate >= 32 random bytes)
SERVER_SESSION_SECRET=
# Separate server pepper for HMAC verification / anti-tamper auditing
SERVER_HMAC_SECRET=
# OAuth / OIDC provider client secrets (Google / Apple — server-side token exchange only)
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_APPLE_PRIVATE_KEY=
# Bot protection server verification secret (Cloudflare Turnstile / hCaptcha)
CAPTCHA_SECRET_KEY=
